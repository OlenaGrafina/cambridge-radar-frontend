# Sanity (public read)
NEXT_PUBLIC_SANITY_PROJECT_ID=polcbwiw
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SITE_URL=https://cambridge-radar.com

# Sanity editor token — API routes write comments, subscribers and messages.
SANITY_WRITE_TOKEN=
# Shared secret for the Sanity publish webhook → /api/revalidate
SANITY_REVALIDATE_SECRET=

# Cloudflare Turnstile (spam protection on comments and forms).
# Without these the forms still work, with a honeypot + rate limit only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend (emails: comment notifications, newsletter confirmation and sending).
# Without a key, emails are skipped and everything is still saved in Sanity.
RESEND_API_KEY=
EMAIL_FROM="Cambridge Radar <radar@cambridge-radar.com>"
